# Configuration for migrateJcasCController2CasCController.sh
# Copy to .env (git-ignored) and adjust. Never commit real tokens.

# Source controller: Jenkins OSS with the JCasC plugin
SRC_URL=https://jenkins.example.com/jcasc-controller
SRC_USER=your-user
SRC_TOKEN=your-api-token

WORK_DIR=$(pwd)/tmpcascworkdir

TEST_CI_VERSION=latest
TEST_CI_TYPE=mm # managed master 
TEST_JENKINS_HOME=$WORK_DIR/jenkins_home
TEST_PORT=9090
TEST_CONTAINER_NAME=casc-controller
TEST_STARTUP_TIMEOUT=500



# Bundle id written to bundle.yaml
BUNDLE_ID=casc-controller

