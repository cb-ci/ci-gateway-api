#!/usr/bin/env bash
# Common environment variables for shell scripts.
# Adjust these values to match your environment as needed.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Path to the Jenkins Configuration as Code bundles source directory

#export CASC_BUNDLES_PATH="${SCRIPT_DIR}/../../../casc/"
export CASC_BUNDLES_PATH="${SCRIPT_DIR}/../../../casc/cjoc-tmp/core-casc-export-jenkins"

# Default Jenkins YAML filename
export JENKINS_YAML="jenkins.yaml"
# Default ITEMS YAML filename
export ITEMS_YAML="items.yaml"

# Default plugins YAML filename (for plugin scripts)
export PLUGINS_YAML="plugins.yaml"

# Base path for plugin scripts to locate casc directory
export BASE_PATH="${SCRIPT_DIR}/../casc"

# Transform file path for cleaning script
export TRANSFORM_FILE="${SCRIPT_DIR}/../transform.yaml"

# Prefix for reading secrets in credentials update script
export VAR_PREFIX='readFile:/var/run/secrets/controller/'
