# Configuration for install.sh and uninstall.sh. Copy to .env and adjust:
#   cp .env.template .env
# .env is git-ignored (**/.env). Do not commit it.

# --- Required (install.sh) ---

# GKE cluster name (as shown by `gcloud container clusters list`)
CLUSTER_NAME=my-cluster

# GKE zone of the cluster. Used as `gcloud container clusters describe --zone`,
# so a zonal location is expected (e.g. europe-west1-b), not a region.
ZONE=my-zone

# Name of the Kubernetes TLS secret created in the test namespace and
# referenced by the Gateway HTTPS listener.
CERT_NAME=test-gateway-tls

# --- Optional (defaults shown; used by both scripts unless noted) ---

# Envoy Gateway Helm chart version (install.sh only), pulled from
# oci://docker.io/envoyproxy/gateway-helm. Pin an explicit version (e.g. v1.x.y)
# if "latest" does not resolve for the OCI chart.
ENVOY_GATEWAY_VERSION=latest

# Namespace of the Envoy Gateway Helm release
ENVOY_GW_NAMESPACE=envoy-gateway-system

# Namespace for the test workload, Gateway and TLS secret
NAMESPACE=test-ns

# Host name for the generated self-signed certificate (install.sh only)
TEST_HOST_NAME=example.com

# GatewayClass name
GATEWAY_CLASS_NAME=eg