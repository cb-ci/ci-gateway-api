# Azure Configuration
export RANDOM_ID="<YOUR_RANDOM_ID>"
export MY_RESOURCE_GROUP_NAME="<YOUR_RESOURCE_GROUP_NAME>"
export REGION="<YOUR_AZURE_REGION>"
export MY_AKS_CLUSTER_NAME="<YOUR_CLUSTER_NAME>"
export MY_DNS_LABEL="<YOUR_DNS_LABEL>"
export MY_SUBSCRIPTION_ID="<YOUR_SUBSCRIPTION_ID>"

# Path configuration
export KUBECONFIG="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/kubeconfig"

# --- CloudBees CI / Gateway Settings ---
# Used by aks/envoy/install.sh and aks/azure-appgw/install.sh
export DOMAIN="<YOUR_DNS_LABEL>.flow-training.beescloud.com"
export NAMESPACE="cloudbees-envoy"
export CONTROLLER_NAME="ha"
export CERT_NAME="cloudbees-cert"
export CLOUDBEES_STORAGE_CLASS="managed-csi"
export ENVOY_GATEWAY_VERSION="v1.7.1"
