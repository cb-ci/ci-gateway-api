#! /bin/bash
export KUBECONFIG=$(pwd)/kubecfg
export AWS_DEFAULT_REGION=us-east-1
export TAG_CB_USER=<USER_ID>
export TAG_CB_OWNER=professional-services
export TAG_CB_ENVIRONMENT=demo
#export CLUSTER_NAME=${TAG_CB_USER}-${TAG_CB_ENVIRONMENT}-001
export CLUSTER_NAME=${TAG_CB_USER}
export NAMESPACE_CLOUDBEES=cbci
export GATEWAY_NAME=cbci-gateway
export CJOC_HOST_NAME=ci.<USER_ID>.aws.ps.beescloud.com
export STORAGE_CLASS_NAME=cbci-efs

# --- Configuration ---
export ENVOY_GATEWAY_VERSION=${ENVOY_GATEWAY_VERSION:-v1.7.1}
export HELM_VERSION_FLAG=""
if [[ "${ENVOY_GATEWAY_VERSION}" != "latest" && -n "${ENVOY_GATEWAY_VERSION}" ]]; then
  export HELM_VERSION_FLAG="--version ${ENVOY_GATEWAY_VERSION}"
fi
export ENVOY_GW_NAMESPACE=envoy-gateway-system
export ACM_CERT_ARN=${ACM_CERT_ARN:-""}
export CLOUDBEES_STORAGE_CLASS=${CLOUDBEES_STORAGE_CLASS:-gp2}


export NAMESPACE_EXTERNAL_DNS="${NAMESPACE_EXTERNAL_DNS:-external-dns}"
export SERVICE_ACCOUNT_NAME="${SERVICE_ACCOUNT_NAME:-external-dns}"
export EXTERNAL_DNS_ROLE_NAME="${EXTERNAL_DNS_ROLE_NAME:-AmazonEKS_ExternalDNS_Role-${CLUSTER_NAME}}"
export EXTERNAL_DNS_POLICY_NAME="${EXTERNAL_DNS_POLICY_NAME:-AmazonEKS_ExternalDNS_Policy-${CLUSTER_NAME}}"
export EXTERNAL_DNS_CHART_VERSION="${EXTERNAL_DNS_CHART_VERSION:-1.15.0}"


