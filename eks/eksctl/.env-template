#! /bin/bash
# Copy to .env, replace every <PLACEHOLDER>, then `source .env`. Every numbered script sources it.
# `.env` holds secrets (CASC_SCM_PASSWORD, CJOC_ADMIN_PASSWORD, GitHub App key): keep it out of git.

# kubeconfig written by 01-createCluster.sh; kubectl/helm in all scripts use it.
export KUBECONFIG=$(pwd)/kubecfg
# AWS region for every aws/eksctl call.
export AWS_DEFAULT_REGION=us-east-1
# Disable the AWS CLI pager so scripts never wait for "q".
export AWS_PAGER=""

# --- Identity and naming ---
# Your user id: tags AWS resources and builds the cluster and host names (eksctl-config.yaml.tpl, 04/07 scripts).
export TAG_CB_USER=<USER_ID>
# Owner tag on AWS resources (eksctl-config.yaml.tpl, 04/07 scripts).
export TAG_CB_OWNER=professional-services
# Environment tag on AWS resources (eksctl-config.yaml.tpl, 04/07 scripts).
export TAG_CB_ENVIRONMENT=demo
#export CLUSTER_NAME=${TAG_CB_USER}-${TAG_CB_ENVIRONMENT}-001
# EKS cluster name; also prefixes IAM, S3 and EFS resource names (used by almost all scripts).
export CLUSTER_NAME=${TAG_CB_USER}
# Namespace for CloudBees CI and the Gateway (05, 07-S3, 09-deleteAll).
export NAMESPACE_CLOUDBEES=cbci
# Name of the Gateway API Gateway (04, 05, 09-deleteAll, casc/cjoc/jenkins.yaml).
export GATEWAY_NAME=cbci-gateway
# Public hostname of the operations center: ACM cert, ALB, Route53 record, Helm host (04, 05, 06).
export CJOC_HOST_NAME=ci.${TAG_CB_USER}.aws.ps.beescloud.com
# StorageClass created for EFS (02-create-efs-filesystem.sh; the script's own default is efs-sc).
export STORAGE_CLASS_NAME=cbci-efs

# --- Configuration ---
# Envoy Gateway chart version, or "latest" (04-installEnvoy.sh).
export ENVOY_GATEWAY_VERSION=${ENVOY_GATEWAY_VERSION:-v1.7.1}
# Derived helm --version flag for the Envoy install (04-installEnvoy.sh); no need to edit.
export HELM_VERSION_FLAG=""
if [[ "${ENVOY_GATEWAY_VERSION}" != "latest" && -n "${ENVOY_GATEWAY_VERSION}" ]]; then
  export HELM_VERSION_FLAG="--version ${ENVOY_GATEWAY_VERSION}"
fi
# Namespace of the Envoy Gateway controller and the ALB Ingress (04, 07-EC2, 09-deleteAll).
export ENVOY_GW_NAMESPACE=envoy-gateway-system
# Existing ACM certificate to reuse; empty = 04-installEnvoy.sh finds or requests one for CJOC_HOST_NAME.
export ACM_CERT_ARN=${ACM_CERT_ARN:-""}
# StorageClass for the CJOC/controller volumes (05-installCloudBees.sh).
export CLOUDBEES_STORAGE_CLASS=${CLOUDBEES_STORAGE_CLASS:-gp2}

# --- external-dns (06-installExternalDNS.sh, 06-deleteExternalDNS.sh) ---
# Namespace for the external-dns release.
export NAMESPACE_EXTERNAL_DNS="${NAMESPACE_EXTERNAL_DNS:-external-dns}"
# ServiceAccount bound to the IAM role through Pod Identity.
export SERVICE_ACCOUNT_NAME="${SERVICE_ACCOUNT_NAME:-external-dns}"
# IAM role external-dns assumes (also removed by 09-deleteAll).
export EXTERNAL_DNS_ROLE_NAME="${EXTERNAL_DNS_ROLE_NAME:-AmazonEKS_ExternalDNS_Role-${CLUSTER_NAME}}"
# Least-privilege Route53 policy for that role (also removed by 09-deleteAll).
export EXTERNAL_DNS_POLICY_NAME="${EXTERNAL_DNS_POLICY_NAME:-AmazonEKS_ExternalDNS_Policy-${CLUSTER_NAME}}"
# external-dns Helm chart version.
export EXTERNAL_DNS_CHART_VERSION="${EXTERNAL_DNS_CHART_VERSION:-1.15.0}"

# --- CasC bundle retriever (05-installCloudBees.sh) ---
# true = operations center loads its CasC bundle from the SCM repo below. Off by default: fill in the CASC_SCM_* vars and CJOC_ADMIN_PASSWORD first.
export CASC_ENABLED=false
# SCM user for the retriever.
export CASC_SCM_USERNAME=<GITHUB_USERNAME>
# SCM token for the retriever (secret).
export CASC_SCM_PASSWORD=<GITHUB_PAT_TOKEN>
# Repository holding the bundles (05, casc/cjoc/jenkins.yaml).
export CASC_SCM_REPO=https://github.com/cb-ci/ci-gateway-api.git
# Bundle root in the repo; only used to build the CJOC path below (not read by any script directly).
export CASC_SCM_BUNDLE_PATH=casc
# Bundle path for the operations center (05-installCloudBees.sh).
export CASC_SCM_BUNDLE_PATH_CJOC=${CASC_SCM_BUNDLE_PATH}/cjoc
# Branch the bundles are read from (05, casc/cjoc controller definitions).
export CASC_SCM_BRANCH=main
# Not read by any script in this repo; only for an external CasC bundle service using a GitHub App.
export CASC_GITHUB_APP_ID=<GITHUB_APP_ID>
# Same as above: indented GitHub App private key from githubAppPrivkey.pem (secret). Sourcing fails to read it if the file is missing.
export CASC_GITHUB_APP_KEY=$(cat $PWD/githubAppPrivkey.pem  | sed 's/^/          /')

# --- Operations center admin (05-installCloudBees.sh) ---
# Default admin password (secret).
export CJOC_ADMIN_PASSWORD=<CJOC_ADMIN_PW>
# Default admin user.
export CJOC_ADMIN_USER=<CJOC_USER>
# Default admin email.
export CJOC_ADMIN_EMAIL=<CJOC_ADMIN_EMAIL>

# --- S3 backup bucket (07-createS3BackupBucket.sh, 07-deleteS3BackupBucket.sh) ---
# export S3_BACKUP_BUCKET=${CLUSTER_NAME}-cbci-backup-<AWS_ACCOUNT_ID>   # default if unset
# Days before backup objects expire (bucket lifecycle rule).
export S3_BACKUP_EXPIRE_DAYS=${S3_BACKUP_EXPIRE_DAYS:-30}
# IAM policy granting bucket access (also removed by 09-deleteAll).
export S3_BACKUP_POLICY_NAME=CBCI-S3Backup-Policy-${CLUSTER_NAME}
# Legacy: not read by any script (access now goes through Pod Identity, not the node role).
export S3_BACKUP_NODEGROUP=${S3_BACKUP_NODEGROUP:-system}
# export S3_BACKUP_ROLE_NAME=CBCI-S3Backup-Role-${CLUSTER_NAME}   # default if unset; role used via Pod Identity
# export S3_BACKUP_SA_NAMESPACE=${NAMESPACE_CLOUDBEES}            # default if unset; namespace of the controllers
# export S3_BACKUP_POD_SELECTOR=com.cloudbees.cje.type=master     # default if unset; label used to discover controller ServiceAccounts
# export S3_BACKUP_SA_NAMES=                                      # default empty; extra ServiceAccounts, comma-separated

# --- S3 artifact storage, Artifact Manager on S3 (07-createS3ArtifactStorage.sh) ---
# export S3_ARTIFACTS_BUCKET=${CLUSTER_NAME}-cbci-artifacts-<AWS_ACCOUNT_ID>   # default if unset
# export S3_ARTIFACTS_PREFIX=artifacts/                           # default; base prefix set in the plugin, empty = none
# export S3_ARTIFACTS_EXPIRE_DAYS=30                              # default; days before artifacts expire
# export S3_ARTIFACTS_SA_NAMES=controller1,hahs,plugable-storage  # default; controller ServiceAccounts, comma-separated
# export S3_ARTIFACTS_SA_NAMESPACE=${NAMESPACE_CLOUDBEES}         # default if unset
# export S3_ARTIFACTS_POLICY_SCOPE=bucket                         # default; "any" widens access to all buckets, avoid
# export S3_ARTIFACTS_POLICY_NAME=CBCI-S3Artifacts-Policy-${CLUSTER_NAME}   # default if unset
# export S3_ARTIFACTS_ROLE_NAME=CBCI-S3Artifacts-Role-${CLUSTER_NAME}       # default if unset

# --- Pluggable storage, Pipeline build logs on S3 (07-createS3PlugableStorage-LogsBucket.sh, 05-installCloudBees.sh) ---
# export S3_LOGS_BUCKET=${CLUSTER_NAME}-cbci-logs-<AWS_ACCOUNT_ID>   # default if unset
# Key prefix for build logs; empty = no prefix (also passed to the Helm chart in 05).
export S3_LOGS_PREFIX=${S3_LOGS_PREFIX-logs/builds/}
# Days before build logs expire.
export S3_LOGS_EXPIRE_DAYS=${S3_LOGS_EXPIRE_DAYS:-30}
# IAM policy granting bucket access (also removed by 09-deleteAll).
export S3_LOGS_POLICY_NAME=CBCI-S3Logs-Policy-${CLUSTER_NAME}
# IAM role used through Pod Identity (also removed by 09-deleteAll).
export S3_LOGS_ROLE_NAME=CBCI-S3Logs-Role-${CLUSTER_NAME}
# ServiceAccount the Helm chart creates for the pluggable storage service.
export S3_LOGS_SA_NAME=pluggable-storage-service
# Namespace of that ServiceAccount.
export S3_LOGS_SA_NAMESPACE=${NAMESPACE_CLOUDBEES}
# true = 05-installCloudBees.sh enables PluggableStorageService (S3); create the bucket with the 07 script first.
export S3_LOGS_ENABLED=${S3_LOGS_ENABLED:-false}

# --- CloudBees CI MCP Router + OAuth (05-installCloudBees.sh, see docs/01-MCP.md) ---
# true = deploys the MCP Router and enables the OAuth authorization server.
export MCP_ENABLED=${MCP_ENABLED:-false}
# AUTO (OAuth + Basic/API token) or OAUTH_ONLY.
export MCP_UPSTREAM_MODE=${MCP_UPSTREAM_MODE:-AUTO}
# Per-caller rate limiting on /mcp.
export MCP_RATE_LIMIT_ENABLED=${MCP_RATE_LIMIT_ENABLED:-false}
# export MCP_RATE_LIMIT_PERMITS=120                                  # requests per window (router default 120)
# export MCP_RATE_LIMIT_WINDOW=1M                                    # window, suffix H/M/S (router default 1M)
# export MCP_CONTROLLERS_CACHE_TTL=1H                                # controller list cache TTL, suffix H/M/S (router default 1H)

# --- Other optional settings, defaults shown ---
# export CHANNEL_PINGER_ENABLED=false           # true = set ChannelPinger interval on CJOC and controllers (05)
# export CHANNEL_PINGER_INTERVAL_SECONDS=1200   # ping interval in seconds (05)
# export HELM_DEBUG=false                       # true = helm --debug in 05
# export EFS_NAME=${CLUSTER_NAME}-efs           # EFS file system name tag (02, 09-deleteAll)
# export EFS_CSI_ROLE_NAME=AmazonEKS_EFS_CSI_DriverRole-${CLUSTER_NAME}   # EFS CSI IAM role (02, 09-deleteAll)

# export ROUTE53_ZONE_DOMAIN=<parent-domain>   # Route53 zone for ACM validation / DNS records (06, 07-EC2); default = CJOC_HOST_NAME / EC2 host minus first label

# --- EC2 Client Controller add-on (07-createEC2WithController.sh) ---
# export EC2_CONTROLLER_HOST_NAME=ec2-controller.<USER_ID>.aws.ps.beescloud.com   # hostname for ACM cert, ALB rule, Route53
# export EC2_CONTROLLER_INSTANCE_NAME=${CLUSTER_NAME}-ec2-controller              # Name tag; also names role/SG
# export EC2_CONTROLLER_INSTANCE_TYPE=t3.medium
# export EC2_CONTROLLER_VOLUME_SIZE=50          # root volume, GB
# export EC2_CONTROLLER_PORT=8080               # controller port behind the ALB
# export EC2_CONTROLLER_KEY_NAME=               # optional SSH key; SSM Session Manager works without one
# export EC2_CONTROLLER_SSH_CIDR=               # SSH source CIDR; default = the VPC CIDR
